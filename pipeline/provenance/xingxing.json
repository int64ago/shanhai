  "source": [
    {
      "book": "山海经·南山经·南山经之首",
      "text": "有獸焉，其狀如禺而白耳，伏行人走，其名曰狌狌，食之善走。"
    }
  ],
  "inferences": [
    {
      "item": "禺形白耳有据；无尾、长臂屈膝与半直立姿势为造型推断。",
      "basis": "原文没有明确尾的有无或长短。本作选择无尾猴猿体态，尾的取舍属于造型推断。"
    },
    {
      "item": "两只圆耳、双手双足与各五指趾，以及掌趾和关节的形状，均为设计补足。",
      "basis": "白耳为明文，耳数、耳形与指趾数量未逐一列明；这些细节据猴猿解剖补出。"
    },
    {
      "item": "白耳据文；灰褐毛发、深灰面庞与掌底足底，以及毛色深浅，均为艺术设色。",
      "basis": "本条仅明记白耳，未规定其余部位颜色。"
    },
    {
      "item": "俯身再起与缓步为对伏行人走的动作演绎；食之善走保留为古籍记述。",
      "basis": "原文未给姿态转换的步骤和速度；食之善走的对象是食用者，不是狌狌的速度测量。"
    }
  ],
