{
  "beast": "jimeng",
  "date": "2026-11-14",
  "status": "parent-reviewed-native-high-runtime",
  "source": [
    {
      "book": "山海经·中山经·中次八经",
      "text": "又東百三十里，曰光山，其上多碧，其下多木。神計蒙處之，其狀人身而龍首，恒遊于漳淵，出入必有飄風暴雨。"
    }
  ],
  "inferences": [
    {
      "item": "人身与龙首（设计参考）",
      "basis": "人身而龍首为明文。直立姿势、双臂双腿、人手人足、体型与肩颈衔接是对人身的设计补足。光山条没有写鸟爪；附近骄山神的羊角虎爪、岐山神的方面三足各属别神。"
    },
    {
      "item": "角须、衣饰与配色（设计参考）",
      "basis": "经文没有规定龙首的角数、须髯、鳞片、衣饰或颜色。双短角、短鬃、浅灰青体表、浅色角鬃、暖粉掌趾与浅赭黄短裤均为艺术补足。"
    },
    {
      "item": "漳渊与风雨（设计参考）",
      "basis": "恒遊于漳淵、出入必有飄風暴雨是明文。具体游姿、是否腾空与墨雨旋风的表现属于艺术演绎；原文记风雨伴随出入，没有写挥臂召雨或雷电法器。"
    },
    {
      "item": "神职与鸣声（考据说明）",
      "basis": "本条称神計蒙，未明写司雨、雨师或东方木神职称，也未记鸣声。"
    }
  ],
