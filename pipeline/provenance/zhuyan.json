  "source": [
    {
      "book": "山海经·西山经·西次二经",
      "text": "有獸焉，其狀如猿，而白首赤足，名曰朱厭，見則大兵。"
    }
  ],
  "inferences": [
    {
      "item": "猿形与白首赤足据文；无尾、长臂屈膝、半直立姿势与体型比例为造型推断。",
      "basis": "小次山条未规定尾巴、猿的具体种类、体量或站姿；本作选择无尾的猴猿形体。"
    },
    {
      "item": "双手双足、各五指趾及手足轮廓均为设计补足；本作双手深灰，只有双足染红。",
      "basis": "原文写赤足，本作采用深灰双手、踝至足趾朱红双足。肢体细节与指趾数量是据猴猿解剖补出的细节。"
    },
    {
      "item": "白毛覆盖头顶、颊颏，身毛炭灰、面手深灰、双足朱红；色区边界与具体色阶为艺术推断。",
      "basis": "白首与赤足是明文，其余配色、白毛覆盖方式及深浅未在本条写定。"
    },
    {
      "item": "缓缓落足、抬首凝望为动作演绎；见则大兵保留为古籍中的战事征兆。",
      "basis": "经文将现身与战事相联，未写操兵能力、战神职称或刚猛性情，动作节奏也未说明。"
    }
  ],
