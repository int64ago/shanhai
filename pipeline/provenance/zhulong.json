  "status": "parent-accepted-public-native-high-runtime",
  "source": [
    {
      "book": "山海经·大荒北经",
      "text": "西北海外，赤水之北，有章尾山。有神，人面蛇身而赤，直目正乘，其暝乃晦，其視乃明，不食不寢不息，風雨是謁。是燭九陰，是謂燭龍。"
    },
    {
      "book": "山海经·海外北经",
      "text": "鍾山之神名曰燭陰，視為晝，瞑為夜，吹為冬，呼為夏，不飲，不食，不息，息為風，身長千里。在無啓之東。其為物，人面，蛇身，赤色，居鍾山下。"
    }
  ],
  "inferences": [
    {
      "item": "两篇神名、山名与尺度分列",
      "basis": "大荒北经称章尾山烛龙，海外北经称钟山烛阴；两篇均记人面蛇身赤色。冬夏、息为风与身长千里属于海外篇，两篇分别引用，不据此断言两山为同一地点。观看缩比属于设计处理。"
    },
    {
      "item": "人面接颈与完整蛇躯",
      "basis": "人面蛇身为明文，完整颅形、发式、面部神情、接颈、蛇躯比例、鳞片、腹侧与尖尾形状未细述。自然相连的人面蛇身与伸展浅S姿态属于造型设计。"
    },
    {
      "item": "直目与肢角选择",
      "basis": "直目正乘保留原句，其含义不直接等同于竖缝瞳孔。普通成对有眼睑眼形、无角、无翼与无肢均为设计选择，原文未明确这些配置。九阴不是九首九眼的器官计数，金焰神冠也无本条依据。"
    },
    {
      "item": "赤色与明晦冬夏演绎",
      "basis": "赤色为明文；朱红蛇躯、暖肤人面、黑发及其具体色阶均为艺术设色。低位原地行波为长躯动作设计。昼夜、冬夏与风雨是两篇叙事，正文未规定具体光源、眼睑动画、攻击过程或鸣声，本模型不据此擅增法器或器官。"
    }
  ],
