    {
      "id": "leishen",
      "content": {
        "path": "content/beasts/leishen.json",
        "sha256": "4c6fd7a393cdb30a2c1d79ea18a5f69ffdac2f604a84476e809a4fee9c767eea",
        "source": [
          {
            "book": "山海经·海内东经",
            "text": "雷澤中有雷神，龍身而人頭，鼓其腹。在吳西。"
          }
