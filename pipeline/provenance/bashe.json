  "source": [
    {
      "book": "山海经·海内南经",
      "text": "巴蛇食象，三歲而出其骨，君子服之，無心腹之疾。其為蛇青黃赤黑。一曰黑蛇青首，在犀牛西。"
    }
  ],
  "inferences": [
    {
      "item": "本作选一曰黑蛇青首的另一说；青黄赤黑另记于正文，四种颜色不混作本作配色。",
      "basis": "同一条先记青黃赤黑，又以一曰引出黑蛇青首。本作选后一说，并保留两种记述及其区别。"
    },
    {
      "item": "长蛇体形、低宽头部、渐细颈部与细尖尾，以及头身长短比例，均为造型推断。",
      "basis": "经文说蛇而能食象，未明记巨蟒种类、长度、头颈比例或鳞片细节；据普通蛇形补足无肢长躯。"
    },
    {
      "item": "炭黑体鳞、灰青头鳞与浅青腹鳞的具体色阶、鳞纹和分区为艺术设色。",
      "basis": "黑身青首有另一说明文依据；灰青色调、浅色腹部与鳞片结构是本作补出的细节。"
    },
    {
      "item": "缓缓蜿行与微微昂首为动作演绎；食象、三年出骨及服之的说法保留为古籍记述。",
      "basis": "本条未记吞食的步骤或蜿行姿态，也未建立人心不足蛇吞象这一俗语的历史源流。"
    }
  ],
