{
  "beast": "yinglong",
  "date": "2026-11-14",
  "status": "parent-reviewed-native-high-runtime",
  "source": [
    {
      "book": "山海經·大荒東經",
      "text": "大荒東北隅中，有山名曰凶犁土丘。應龍處南極，殺蚩尤與夸父，不得復上，故下數旱。旱而為應龍之狀，乃得大雨。"
    },
    {
      "book": "山海經·大荒北經",
      "text": "應龍已殺蚩尤，又殺夸父，乃去南方處之，故南方多雨。"
    },
    {
      "book": "山海經·大荒北經",
      "text": "黄帝乃令應龍攻之冀州之野。應龍畜水。"
    }
  ],
  "inferences": [
    {
      "item": "有翼参考郭注，双羽翼为设计选择",
      "basis": "四库本卷十四郭璞注有龍有翼者也，属于注释，与正文分列。双翼、羽翼形制、肩侧布局、翼展与拍动均属设计补足，郭注未规定这些细节。"
    },
    {
      "item": "细长龙躯、龙首与肢角配置",
      "basis": "正文未逐项写头形、角须、足数、趾数、鳞片、尾形或躯干比例。完整龙首、颈腹长躯、渐细尖尾、无足无角及伸展浅S姿态均属设计选择；原文没有明确无足无角。"
    },
    {
      "item": "苍青、浅腹与素白羽翼",
      "basis": "所引正文未记配色，具体蓝绿色阶、浅色腹鳞、素白翼与鳞羽过渡均属艺术设色。"
    },
    {
      "item": "行波、展翼与风雨演绎",
      "basis": "畜水、旱雨为叙事依据；行波、展翼、鸣声与云雨表现属于艺术演绎。女魃止雨在原文中另有主体，禹尾画地导水与展翼即生风雨雷电均不见于这些所引正文。"
    }
  ],
