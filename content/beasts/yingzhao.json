{
  "id": "yingzhao",
  "name": "英招",
  "archetype": "quadruped",
  "source": [
    {
      "book": "山海經·西山經·西次三經",
      "text": "實惟帝之平圃，神英招司之，其狀馬身而人面，虎文而鳥翼，狥于四海，其音如橊。"
    }
  ],
  "inferred": [
    {
      "item": "一张人面、四足马躯与一条马尾",
      "basis": "马身、人面据原文；人首的完整颅形、发须、肤色及颈部过渡为视觉补足。采用四足单蹄与一条马尾，尾的数量、长度与黑褐毛色未见原文规定；不另加角、冠冕或第二张兽面。"
    },
    {
      "item": "双鸟翼、肩部独立翼根与深灰羽色",
      "basis": "鸟翼据原文，双翼数量、肩侧位置、长羽层次、翼展与灰黑设色均为艺术推断。双翼各有独立骨链，稳立时舒翼，不把巡行直接等同于飞行。"
    },
    {
      "item": "赭金马身上的墨黑虎纹",
      "basis": "虎文据原文；虎纹的分布、具体条数、赭金底色、白色下肢及墨黑条纹是设色与图案推断。"
    },
    {
      "item": "地面巡行、舒翼顾盼与短促颤鸣",
      "basis": "狥于四海据原文，可理解为周行；以地面缓步与稳立舒翼表现巡行之意，未增补后世神职。原文其音如橊的具体声义不明确，不擅断为马嘶、虎啸或人语；短促颤鸣的音高、音色和节奏仅作听觉演绎。"
    }
  ],
