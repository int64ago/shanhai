  "archetype": "quadruped",
  "source": [
    {
      "book": "山海經·北山經·北山經之首",
      "text": "又北二百里，曰少咸之山，無草木，多青碧。有獸焉，其狀如牛，而赤身、人面、馬足，名曰窫窳，其音如嬰兒，是食人。"
    }
  ],
  "inferred": [
    {
      "item": "牛状四足躯干、单张人面与短颈肩",
      "basis": "其状如牛、人面、马足据本篇；四足布局、完整人首的比例、短颈与肩胸肌肉、发须、耳形和面部赤褐肤色为造型补足。无角为本次设计选择，原文没有规定角的有无。只呈现少咸之山本条形态。"
    },
    {
      "item": "朱赭赤身与四只墨褐单蹄",
      "basis": "赤身据原文；朱赭的具体色值、深浅毛皮、墨褐马蹄和短毛质感为设色推断。四只单蹄沿用可信马足几何，牛躯下肢与马蹄间的短系部为新增离线雕刻，不冒称生成服务新 HIGH 输出。"
    },
    {
      "item": "一条细长牛尾与尾端短簇",
      "basis": "本条未规定尾的有无、数量与形状。以牛状身体为依据补一条下垂细尾及深色尾簇，原母件尾已清理，尾部为项目离线制作。"
    },
    {
      "item": "稳立顾盼、四拍缓步与拟婴啼",
      "basis": "地面缓步及稳立微俯首的表演是展示动作，未声称原文记载神通。其音如婴儿据正文，合成鸣声的音高、共振峰、颤音、节奏与混响为听觉演绎。是食人作为原文习性保留，不据此添加法术。"
    }
  ],
