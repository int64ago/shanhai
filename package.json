{
  "name": "shanhai",
  "private": true,
  "version": "0.2.0",
  "description": "Shanhai World (山海异兽录) — Interactive 3D Bestiary of the Classic of Mountains and Seas in Chinese Gongbi Ink-Wash Style",
  "homepage": "https://shanhaiworld.org/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/int64ago/shanhai.git"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "validate": "tsx pipeline/validate.ts",
    "rodin": "tsx pipeline/rodin/generate.ts",
    "rodin:balance": "tsx pipeline/rodin/generate.ts --balance",
    "tts": "tsx pipeline/tts/narrate.ts",
    "tts:all": "tsx pipeline/tts/narrate.ts --all"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "postprocessing": "^6.39.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "~0.186.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "~0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "leva": "^0.10.1",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
